# -------------------------------------------------------
# VoiceB2B Server — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control.
# -------------------------------------------------------

# MongoDB connection string
# Local example:  mongodb://localhost:27017/voiceb2b
# Atlas example:  mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/voiceb2b
MONGODB_URI=mongodb://localhost:27017/voiceb2b

# Port the Express server will listen on
PORT=5000

# Node environment (development | production)
NODE_ENV=development

# ── Auth ─────────────────────────────────────────────────────────────────────
# Secret key used to sign and verify JWTs.
# IMPORTANT: Replace with a long, random string in your actual .env file.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_secret_here
